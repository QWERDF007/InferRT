{
  "description": "Keep WORKLOG.md synchronized with project changes before Codex ends a turn.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/worklog_reminder.py",
            "commandWindows": "python .codex\\hooks\\worklog_reminder.py",
            "timeout": 10,
            "statusMessage": "Checking WORKLOG.md"
          }
        ]
      }
    ]
  }
}
