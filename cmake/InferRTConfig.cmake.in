@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

set(TRT_ROOT "@TRT_ROOT@" CACHE PATH "TensorRT installation directory")
set(TRT_VERSION "@TRT_VERSION@" CACHE STRING "TensorRT version")
set(ONNXRUNTIME_ROOT "@ONNXRUNTIME_ROOT@" CACHE PATH "ONNX Runtime installation directory")
set(INFERRT_OPENVINO_ROOT "@INFERRT_OPENVINO_ROOT@" CACHE PATH "OpenVINO toolkit root directory")
set(OpenCV_DIR "@OpenCV_DIR@" CACHE PATH "OpenCV package directory")
set(Faiss_HOME "@Faiss_HOME@" CACHE PATH "Faiss installation root")
set(MKL_ROOT "@MKL_ROOT@" CACHE PATH "Intel MKL installation root")

find_dependency(CUDAToolkit)
find_dependency(OpenCV REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/FindTensorRT.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ConfigONNXRuntime.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ConfigOpenVINO.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ConfigFaiss.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/InferRTTargets.cmake")
