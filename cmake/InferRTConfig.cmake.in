@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

set(INFERRT_ENABLE_CUDA "@INFERRT_ENABLE_CUDA@")
set(INFERRT_BUILD_TENSORRT "@INFERRT_BUILD_TENSORRT@")
set(INFERRT_BUILD_ONNX "@INFERRT_BUILD_ONNX@")
set(INFERRT_BUILD_OPENVINO "@INFERRT_BUILD_OPENVINO@")

set(_inferrt_requested_components ${InferRT_FIND_COMPONENTS})
if(NOT _inferrt_requested_components)
    # A plain find_package() must remain usable for the dependency-free core
    # target.  Backend targets opt into their development dependencies by
    # naming the corresponding component.
    set(_inferrt_requested_components core)
endif()

set(_inferrt_need_cuda OFF)
set(_inferrt_need_opencv OFF)
set(_inferrt_need_tensorrt OFF)
set(_inferrt_need_faiss OFF)
set(_inferrt_need_onnx OFF)
set(_inferrt_need_openvino OFF)
foreach(_inferrt_component IN LISTS _inferrt_requested_components)
    if(INFERRT_ENABLE_CUDA AND (_inferrt_component STREQUAL "util"
       OR _inferrt_component STREQUAL "cvcuda"
       OR _inferrt_component STREQUAL "model"
       OR _inferrt_component STREQUAL "engine"
       OR _inferrt_component STREQUAL "features"))
        set(_inferrt_need_cuda ON)
    endif()
    if(_inferrt_component STREQUAL "cvcuda"
       OR _inferrt_component STREQUAL "model"
       OR _inferrt_component STREQUAL "engine"
       OR _inferrt_component STREQUAL "features")
        set(_inferrt_need_opencv ON)
    endif()
    if(_inferrt_component STREQUAL "model"
       OR _inferrt_component STREQUAL "engine"
       OR _inferrt_component STREQUAL "features")
        set(_inferrt_need_tensorrt ON)
    endif()
    if(_inferrt_component STREQUAL "features")
        set(_inferrt_need_faiss ON)
    endif()
endforeach()
if(_inferrt_need_tensorrt AND INFERRT_BUILD_ONNX)
    set(_inferrt_need_onnx ON)
endif()
if(_inferrt_need_tensorrt AND INFERRT_BUILD_OPENVINO)
    set(_inferrt_need_openvino ON)
endif()

if(_inferrt_need_cuda)
    find_dependency(CUDAToolkit)
endif()

if(_inferrt_need_tensorrt AND INFERRT_BUILD_TENSORRT)
    include("${CMAKE_CURRENT_LIST_DIR}/FindTensorRT.cmake")
endif()

if(_inferrt_need_opencv)
    find_dependency(OpenCV)
endif()

if(_inferrt_need_onnx)
    include("${CMAKE_CURRENT_LIST_DIR}/ConfigONNXRuntime.cmake")
endif()

if(_inferrt_need_openvino)
    include("${CMAKE_CURRENT_LIST_DIR}/ConfigOpenVINO.cmake")
endif()

if(_inferrt_need_faiss)
    include("${CMAKE_CURRENT_LIST_DIR}/ConfigFaiss.cmake")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/InferRTTargets.cmake")

foreach(_inferrt_component IN LISTS _inferrt_requested_components)
    if(TARGET InferRT::${_inferrt_component})
        set(InferRT_${_inferrt_component}_FOUND TRUE)
    else()
        set(InferRT_${_inferrt_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(InferRT)

unset(_inferrt_component)
unset(_inferrt_requested_components)
unset(_inferrt_need_cuda)
unset(_inferrt_need_opencv)
unset(_inferrt_need_tensorrt)
unset(_inferrt_need_faiss)
unset(_inferrt_need_onnx)
unset(_inferrt_need_openvino)
